  "fields": [
    {
      "id": "annual_mean_temperature",
      "unit": "degC",
      "formula": "mean_months((tmin+tmax)/2)",
      "note": "Derived midpoint estimate, equal month weights; not separately supplied tavg.",
      "period": "1970-2000",
      "index": 0
    },
    {
      "id": "annual_precipitation",
      "unit": "mm/year",
      "formula": "sum_months(prec)",
      "period": "1970-2000",
      "index": 1
    },
    {
      "id": "hottest_month_mean_daily_maximum_temperature",
      "unit": "degC",
      "formula": "max_months(tmax)",
      "note": "Monthly mean of daily maxima; not an extreme daily observation.",
      "period": "1970-2000",
      "index": 2
    },
    {
      "id": "de_martonne_aridity",
      "unit": "index",
      "formula": "annual_precipitation/(annual_mean_temperature+10)",
      "note": "Defined only for T > -10 C; larger means wetter relative to temperature. Not water availability.",
      "period": "1970-2000",
      "index": 3
    },
